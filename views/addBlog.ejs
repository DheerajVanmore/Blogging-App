<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Writing Studio — Blogify</title>
</head>
<body>
    <%- include('./partials/nav') %>

    <main class="studio-container">
        <!-- Breadcrumb / Header -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <a href="/" class="btn-editorial-outline btn-editorial-sm">
                <i class="bi bi-arrow-left"></i> Back to Feed
            </a>
            <div class="text-muted small">
                <i class="bi bi-pencil-fill me-1"></i> Story Draft
            </div>
        </div>

        <div class="studio-card">
            <div class="studio-header">
                <h1 class="mb-1" style="font-size: 2rem;">Publish a Story</h1>
                <p class="text-muted mb-0 small">Share your insights, knowledge, and perspectives with readers worldwide.</p>
            </div>

            <!-- Form -->
            <form action="/blog" method="post" enctype="multipart/form-data">
                
                <!-- Cover Image Upload Area -->
                <div class="mb-4">
                    <label class="form-label-editorial mb-2">
                        <i class="bi bi-image"></i> Cover Photo
                    </label>

                    <div class="dropzone-box" id="coverImageDropzone" onclick="document.getElementById('coverImage').click();">
                        <!-- Initial Prompt -->
                        <div id="dropzonePrompt">
                            <div class="dropzone-icon">
                                <i class="bi bi-cloud-arrow-up"></i>
                            </div>
                            <h6 class="mb-1 fw-bold text-dark">Click to upload or drag and drop</h6>
                            <p class="text-muted small mb-0">PNG, JPG, WebP or GIF (Recommended: 1200x630)</p>
                        </div>

                        <!-- Live Preview Display -->
                        <div id="coverImagePreviewContainer" class="dropzone-preview-container">
                            <img id="coverImagePreview" src="" alt="Cover Preview" class="dropzone-preview-img" />
                            <button type="button" id="removeCoverImage" class="dropzone-remove-btn" title="Remove Cover Photo">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Hidden native file input -->
                    <input
                        type="file"
                        class="d-none"
                        id="coverImage"
                        name="coverImage"
                        accept="image/*"
                    />
                </div>

                <!-- Story Title Input -->
                <div class="mb-4">
                    <label for="title" class="form-label-editorial mb-2">
                        <i class="bi bi-type-h1"></i> Headline
                    </label>
                    <input
                        type="text"
                        class="studio-title-input"
                        id="title"
                        name="title"
                        placeholder="Give your story a compelling title..."
                        required
                        autocomplete="off"
                    />
                </div>

                <!-- Story Body Textarea -->
                <div class="mb-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <label for="body" class="form-label-editorial mb-0">
                            <i class="bi bi-text-paragraph"></i> Article Content
                        </label>
                        <span id="studioWordCount" class="text-muted small">0 words</span>
                    </div>

                    <textarea
                        class="form-control studio-body-textarea auto-resize-textarea"
                        id="studioBody"
                        name="body"
                        placeholder="Tell your story... You can write multiple paragraphs, share quotes, and express your ideas freely."
                        required
                    ></textarea>
                </div>

                <!-- Publishing Actions -->
                <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                    <a href="/" class="btn-editorial-outline">
                        Cancel
                    </a>
                    <button type="submit" class="btn-editorial-primary btn-editorial-lg">
                        <i class="bi bi-send"></i> Publish Story
                    </button>
                </div>
            </form>
        </div>
    </main>

    <%- include('./partials/footer') %>
    <%- include('./partials/scripts') %>
</body>
</html>