<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title>Sign In — Blogify</title>
  </head>
  <body>
    <%- include('./partials/nav') %>

    <div class="auth-wrapper">
      <div class="auth-card">
        <!-- Auth Header -->
        <div class="auth-header">
          <div class="auth-badge">
            <i class="bi bi-feather"></i>
          </div>
          <h1 class="auth-title">Welcome Back</h1>
          <p class="auth-subtitle">
            Sign in to continue sharing your perspective and connecting with fellow writers.
          </p>
        </div>

        <!-- Login Form -->
        <form action="/user/login" method="post">
          <!-- Email Input -->
          <div class="mb-3">
            <label for="emailInput" class="form-label-editorial">
              <i class="bi bi-envelope"></i> Email Address
            </label>
            <input
              type="email"
              class="form-control form-control-editorial"
              name="email"
              id="emailInput"
              placeholder="name@example.com"
              required
              autocomplete="email"
            />
          </div>

          <!-- Password Input with Show/Hide -->
          <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between mb-1">
              <label for="passwordInput" class="form-label-editorial mb-0">
                <i class="bi bi-lock"></i> Password
              </label>
            </div>
            <div class="input-password-group">
              <input
                type="password"
                class="form-control form-control-editorial pe-5"
                name="password"
                id="passwordInput"
                placeholder="Enter your password"
                required
                autocomplete="current-password"
              />
              <button
                type="button"
                class="btn-toggle-password"
                data-target="passwordInput"
                aria-label="Toggle password visibility"
              >
                <i class="bi bi-eye"></i>
              </button>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="d-grid mb-3">
            <button type="submit" class="btn-editorial-primary btn-editorial-lg w-100">
              <i class="bi bi-box-arrow-in-right"></i> Sign In
            </button>
          </div>
        </form>

        <!-- Switch to Signup -->
        <div class="text-center pt-3 border-top">
          <p class="text-muted small mb-0">
            Don't have an account?
            <a href="/user/signup" class="text-decoration-none fw-semibold" style="color: var(--accent-primary);">
              Create an account
            </a>
          </p>
        </div>
      </div>
    </div>

    <%- include('./partials/footer') %>
    <%- include('./partials/scripts') %>
  </body>
</html>
