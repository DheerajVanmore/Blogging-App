<nav class="navbar navbar-expand-lg editorial-navbar sticky-top">
  <div class="container">
    <!-- Brand Logo -->
    <a class="navbar-brand-editorial" href="/">
      <div class="brand-icon-box">
        <i class="bi bi-feather"></i>
      </div>
      <span>Blogify</span>
    </a>

    <!-- Mobile Hamburger Toggle -->
    <button
      class="navbar-toggler border-0 shadow-none p-1"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarEditorialContent"
      aria-controls="navbarEditorialContent"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <i class="bi bi-list fs-2 text-dark"></i>
    </button>

    <!-- Nav Links & Actions -->
    <div class="collapse navbar-collapse" id="navbarEditorialContent">
      <ul class="navbar-nav me-auto ms-lg-4 mb-2 mb-lg-0 align-items-lg-center">
        <li class="nav-item">
          <a class="nav-link-editorial active" aria-current="page" href="/">
            <i class="bi bi-grid-1x2"></i> Feed
          </a>
        </li>
      </ul>

      <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
        <% if (locals.user) { %>
          <!-- Write Story Button -->
          <a href="/blog/add-new" class="btn-editorial-primary btn-editorial-sm">
            <i class="bi bi-pencil-square"></i>
            <span>Write Story</span>
          </a>

          <!-- User Profile Dropdown -->
          <div class="dropdown">
            <button
              class="user-dropdown-btn dropdown-toggle border-0"
              type="button"
              id="userProfileDropdown"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              <img
                src="<%= locals.user.avatar || locals.user.profileImageURL || '/images/avatar.png' %>"
                alt="Avatar"
                class="user-avatar-mini"
                onerror="this.src='/images/avatar.png'"
              />
              <span class="d-none d-sm-inline"><%= locals.user.fullName || (locals.user.email ? locals.user.email.split('@')[0] : 'Writer') %></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end editorial-dropdown-menu" aria-labelledby="userProfileDropdown">
              <li class="px-3 py-2 border-bottom mb-1">
                <div class="small fw-bold text-dark text-truncate" style="max-width: 180px;">
                  <%= locals.user.fullName || locals.user.email %>
                </div>
                <div class="text-muted" style="font-size: 0.78rem;">
                  <%= locals.user.role || 'Member' %>
                </div>
              </li>
              <li>
                <a class="editorial-dropdown-item" href="/blog/add-new">
                  <i class="bi bi-plus-circle"></i> New Article
                </a>
              </li>
              <li><hr class="dropdown-divider my-1"></li>
              <li>
                <a class="editorial-dropdown-item danger" href="/user/logout">
                  <i class="bi bi-box-arrow-right"></i> Sign Out
                </a>
              </li>
            </ul>
          </div>
        <% } else { %>
          <!-- Guest Navigation -->
          <a href="/user/login" class="nav-link-editorial">
            Sign In
          </a>
          <a href="/user/signup" class="btn-editorial-dark btn-editorial-sm">
            Get Started
          </a>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<!-- System / Flash Alert Message -->
<% if (locals.error) { %>
  <div class="container mt-3">
    <div class="editorial-alert alert alert-dismissible fade show shadow-sm" role="alert">
      <i class="bi bi-exclamation-circle-fill fs-5"></i>
      <div class="flex-grow-1"><%= locals.error %></div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  </div>
<% } %>
